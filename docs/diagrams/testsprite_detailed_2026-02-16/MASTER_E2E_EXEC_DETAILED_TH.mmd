  classDef ok fill:#f0fdf4,stroke:#15803d,color:#14532d,stroke-width:1px;
  classDef warn fill:#fff7ed,stroke:#c2410c,color:#7c2d12,stroke-width:1px;
  classDef qc fill:#f8fafc,stroke:#0f766e,color:#134e4a,stroke-width:1px;
  classDef data fill:#f1f5f9,stroke:#1d4ed8,color:#1e3a8a,stroke-width:1px;
  classDef kpi fill:#f8fafc,stroke:#0f766e,color:#134e4a,stroke-width:1px;
