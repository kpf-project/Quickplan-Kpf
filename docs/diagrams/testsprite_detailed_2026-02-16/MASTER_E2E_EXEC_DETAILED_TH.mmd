flowchart TD
  subgraph L0["ชั้นกำกับดูแลและบทบาท"]
    R1["รองผู้จัดการวางแผนหลัก\nบทบาท: สร้างและประกาศใช้แผนหลัก"]:::role
    R2["คิวเอแผนกเอ\nบทบาท: คำนวณและยืนยันแผนย่อยเฉพาะแผนกเอ"]:::role
    R3["คิวเอแผนกบี\nบทบาท: คำนวณและยืนยันแผนย่อยเฉพาะแผนกบี"]:::role
    R4["ผู้ดูข้อมูล\nบทบาท: อ่านข้อมูลและรายงานเท่านั้น"]:::role
    R5["ผู้จัดการข้อยกเว้น\nบทบาท: จัดการความเสี่ยงและปรับแผน"]:::role
  end

  subgraph P0["ช่วงที่ศูนย์ เตรียมความพร้อมระบบ"]
    A1["กำหนดบทบาทและผู้ใช้งาน"]:::stage
    A2["ผูกผู้ใช้กับแผนก\nพร้อมกำหนดสิทธิ์แก้ไขหรือดู"]:::stage
    A3["ผูกเจ้าของสินค้าในแต่ละแผนก"]:::stage
    A4["ผูกเจ้าของวัตถุดิบ"]:::stage
    A5["ตรวจสูตรการผลิตเป็นสถานะอนุมัติแล้ว"]:::stage
    A6["ตรวจข้อมูลระบบหลักพร้อมใช้งาน\nคงเหลือ คำสั่งซื้อคงค้าง ค่าต่ำสุดสูงสุด เวลานำส่ง"]:::stage
    A7{"ผ่านเงื่อนไขก่อนเริ่มหรือไม่"}:::decision
    A8["อนุญาตให้เริ่มทดสอบ"]:::ok
    A9["หยุดและแก้ข้อมูลตั้งต้น"]:::warn
  end
  A1 --> A2 --> A3 --> A4 --> A5 --> A6 --> A7
  A7 -- "ผ่าน" --> A8
  A7 -- "ไม่ผ่าน" --> A9

  subgraph P1["ช่วงที่หนึ่ง วางแผนหลักรายสัปดาห์"]
    B1["สร้างเลขแผนหลัก"]:::stage
    B2["บันทึกรายการผลิตรายวันของสัปดาห์"]:::stage
    B3["ตรวจความครบถ้วนก่อนประกาศใช้"]:::qc
    B4["ประกาศใช้แผนหลัก"]:::stage
    B5["ระบบเตรียมงานให้แผนย่อย"]:::ok
  end
  A8 --> B1 --> B2 --> B3 --> B4 --> B5
  R1 -.-> B1
  R1 -.-> B4

  subgraph P2["ช่วงที่สอง แผนย่อยระดับแผนก"]
    C1["คิวเอเปิดแผนจากกล่องงานเข้า"]:::stage
    C2["ระบบกรองรายการตามสิทธิ์ของแผนก"]:::stage
    C3{"ผู้ใช้มีสิทธิ์แก้ไขหรือไม่"}:::decision
    C4["แก้ไขแผนย่อยได้เฉพาะขอบเขตตนเอง"]:::ok
    C5["อ่านได้อย่างเดียว"]:::warn
    C6["สั่งคำนวณ"]:::stage
  end
  B5 --> C1 --> C2 --> C3
  C3 -- "มีสิทธิ์" --> C4 --> C6
  C3 -- "ไม่มีสิทธิ์" --> C5
  R2 -.-> C1
  R3 -.-> C1
  R4 -.-> C1
  R2 -.-> C6
  R3 -.-> C6

  subgraph P3["ช่วงที่สาม คำนวณวัตถุดิบและสถานะแผน"]
    D1["แตกสูตรการผลิต\nสินค้าสำเร็จรูป ไป งานระหว่างผลิต ไป วัตถุดิบ"]:::stage
    D2["รวมปริมาณวัตถุดิบที่ต้องใช้"]:::stage
    D3["ดึงคงเหลือสุทธิ"]:::data
    D4["ดึงคำสั่งซื้อคงค้างและวันที่คาดรับ"]:::data
    D5["ดึงค่าต่ำสุดสูงสุดและเวลานำส่ง"]:::data
    D6{"คงเหลือเพียงพอหรือไม่"}:::decision
    D7["กำหนดสถานะพร้อมผลิต"]:::ok
    D8["คำนวณปริมาณขาด"]:::stage
    D9{"มีคำสั่งซื้อคงค้างหรือไม่"}:::decision
    D10["ใช้วันที่คาดรับจากคำสั่งซื้อคงค้าง"]:::ok
    D11["ใช้เวลานำส่งเป็นค่าทดแทน"]:::warn
    D12["บันทึกผลคำนวณของแต่ละรายการ"]:::stage
  end
  C6 --> D1 --> D2 --> D3 --> D4 --> D5 --> D6
  D6 -- "เพียงพอ" --> D7 --> D12
  D6 -- "ไม่เพียงพอ" --> D8 --> D9
  D9 -- "มี" --> D10 --> D12
  D9 -- "ไม่มี" --> D11 --> D12

  subgraph P4["ช่วงที่สี่ ยืนยันแผนย่อยและออกใบเบิก"]
    E1["ยืนยันแผนย่อย"]:::stage
    E2["เลือกรูปแบบใบเบิก\nรายสัปดาห์หรือรายวัน"]:::stage
    E3["แยกรายการตามเจ้าของวัตถุดิบ"]:::qc
    E4["สร้างเลขเอกสารใบเบิก"]:::qc
    E5["ส่งออกเอกสารใบเบิก"]:::stage
    E6["ตรวจความครบถ้วนของเอกสาร"]:::qc
    E7["พร้อมนำเข้าไปยังระบบหลัก"]:::ok
  end
  D12 --> E1 --> E2 --> E3 --> E4 --> E5 --> E6 --> E7
  R2 -.-> E1
  R3 -.-> E1
  R2 -.-> E5
  R3 -.-> E5

  subgraph P5["ช่วงที่ห้า จัดการความเสี่ยงและปรับแผน"]
    F1["ติดตามสถานะในศูนย์ควบคุม"]:::stage
    F2["ระบุงานล่าช้าหรือเสี่ยงขาด"]:::stage
    F3["บันทึกวันที่คาดรับใหม่"]:::stage
    F4["สั่งปรับแผน"]:::stage
    F5["ระบบอัปเดตแผนตามข้อมูลใหม่"]:::ok
  end
  D12 --> F1 --> F2 --> F3 --> F4 --> F5
  F5 --> E1
  R5 -.-> F1
  R5 -.-> F3
  R5 -.-> F4

  subgraph P6["ช่วงที่หก ตรวจย้อนรอยและปิดรอบทดสอบ"]
    G1["ตรวจย้อนรอยผลกระทบ\nจากแผนหลักไปแผนย่อยและวัตถุดิบ"]:::stage
    G2["สรุปรายงานผลและรายการค้าง"]:::stage
    G3["รวบรวมหลักฐานทดสอบ"]:::stage
    G4["ปิดรอบทดสอบและส่งลงนาม"]:::ok
  end
  E7 --> G1 --> G2 --> G3 --> G4
  F5 --> G1
  R1 -.-> G1
  R4 -.-> G2

  subgraph K["เกณฑ์ตัดสินความถูกต้องของข้อมูล"]
    K1["สิทธิ์ถูกต้อง\nผู้ใช้แก้ไขได้เฉพาะขอบเขต"]:::kpi
    K2["สูตรถูกต้อง\nปริมาณสัมพันธ์กับสูตรที่อนุมัติแล้ว"]:::kpi
    K3["คงเหลือถูกต้อง\nใช้คงเหลือก่อน แล้วคำสั่งซื้อคงค้าง แล้วเวลานำส่ง"]:::kpi
    K4["ใบเบิกถูกต้อง\nแยกรายการตามเจ้าของวัตถุดิบ"]:::kpi
    K5["เลขเอกสารถูกต้อง\nใช้เลขใบเบิก ไม่ใช้เลขแผน"]:::kpi
  end
  C2 --> K1
  D1 --> K2
  D3 --> K3
  E3 --> K4
  E4 --> K5

