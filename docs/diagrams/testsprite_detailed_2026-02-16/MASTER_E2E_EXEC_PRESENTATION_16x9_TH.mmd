flowchart LR
  subgraph G1["ช่วงเตรียมความพร้อม"]
    A1["กำหนดบทบาท\nและผู้ใช้งาน"]:::stage
    A2["ผูกผู้ใช้กับแผนก\nและเจ้าของสินค้า"]:::stage
    A3["ผูกเจ้าของวัตถุดิบ\nและตรวจสูตรอนุมัติ"]:::stage
    A4["ยืนยันข้อมูลระบบหลักพร้อม\nคงเหลือ คำสั่งซื้อคงค้าง เวลานำส่ง"]:::stage
  end

  subgraph G2["ช่วงวางแผนและคำนวณ"]
    B1["สร้างและประกาศใช้\nแผนหลักรายสัปดาห์"]:::stage
    B2["คิวเอเปิดแผนย่อย\nตามสิทธิ์ของแผนก"]:::stage
    B3["คำนวณจากสูตรการผลิต\nสินค้าสำเร็จรูป งานระหว่างผลิต วัตถุดิบ"]:::stage
    B4{"คงเหลือเพียงพอหรือไม่"}:::decision
    B5["เพียงพอ\nกำหนดสถานะพร้อมผลิต"]:::ok
    B6["ไม่เพียงพอ\nใช้คำสั่งซื้อคงค้างหรือเวลานำส่ง"]:::warn
  end

  subgraph G3["ช่วงใบเบิกและติดตามผล"]
    C1["ยืนยันแผนย่อย\nและส่งออกใบเบิก"]:::stage
    C2["แยกรายการใบเบิก\nตามเจ้าของวัตถุดิบ"]:::qc
    C3["สร้างเลขเอกสารใบเบิก\nเพื่อใช้นำเข้าระบบหลัก"]:::qc
    C4["ติดตามข้อยกเว้น\nศูนย์ควบคุม ปรับแผนตามข้อมูลใหม่"]:::stage
    C5["ตรวจย้อนรอยและสรุปผล\nปิดรอบทดสอบ"]:::ok
  end

  subgraph G4["เกณฑ์ผ่านงาน"]
    K1["สิทธิ์ไม่ข้ามแผนก\nและผู้ดูข้อมูลเขียนไม่ได้"]:::kpi
    K2["ปริมาณสัมพันธ์กับสูตรที่อนุมัติแล้ว"]:::kpi
    K3["ตรรกะคงเหลือถูกต้อง\nคงเหลือก่อน คำสั่งซื้อคงค้างถัดไป เวลานำส่งสุดท้าย"]:::kpi
    K4["ใบเบิกแยกตามเจ้าของวัตถุดิบถูกต้อง"]:::kpi
    K5["ใช้เลขใบเบิก\nไม่ใช้เลขแผน"]:::kpi
  end

  A1 --> A2 --> A3 --> A4 --> B1 --> B2 --> B3 --> B4
  B4 -- "พอ" --> B5 --> C1
  B4 -- "ไม่พอ" --> B6 --> C1
  C1 --> C2 --> C3 --> C4 --> C5
  C5 --> K1 --> K2 --> K3 --> K4 --> K5

  classDef stage fill:#ffffff,stroke:#475569,color:#0f172a,stroke-width:1px;
  classDef decision fill:#eef2ff,stroke:#4338ca,color:#1e1b4b,stroke-width:1px;
  classDef ok fill:#f0fdf4,stroke:#15803d,color:#14532d,stroke-width:1px;
  classDef warn fill:#fff7ed,stroke:#c2410c,color:#7c2d12,stroke-width:1px;
  classDef qc fill:#f8fafc,stroke:#0f766e,color:#134e4a,stroke-width:1px;
  classDef kpi fill:#f8fafc,stroke:#0f766e,color:#134e4a,stroke-width:1px;
