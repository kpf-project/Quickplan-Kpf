  return <div className="fixed inset-0 z-50 bg-[#102C57]/50 p-4 md:p-10"><div className="mx-auto flex max-h-full max-w-[1250px] flex-col overflow-hidden border border-slate-300 bg-white"><div className="flex items-center justify-between bg-[#102C57] px-4 py-3 text-white"><div><strong>เลือก WIP เพื่อวางแผน</strong><span className="ml-3 text-xs text-white/70">Section: {activeSection?.name || "ทุก Section"}</span></div><button type="button" onClick={onClose} className="text-xs font-bold">ปิด</button></div><div className="overflow-auto p-4"><div className="mb-3 flex flex-wrap gap-2">{sectionOptions.map((section) => <span key={section.id} className={`border px-3 py-1 text-xs font-bold ${String(section.id) === String(activeSection?.id) ? "border-[#102C57] bg-[#102C57] text-white" : "border-slate-300 text-slate-600"}`}>{section.name}</span>)}</div><div className="overflow-x-auto"><table className="min-w-[920px] w-full border-collapse text-xs"><thead><tr className="bg-[#102C57] text-white"><th className="px-3 py-2 text-left">วันที่</th><th className="px-3 py-2 text-left">กะของ Section</th><th className="px-3 py-2 text-left">รหัส WIP</th><th className="px-3 py-2 text-left">ชื่อ WIP</th><th className="px-3 py-2 text-right">จำนวนแผน</th><th className="px-3 py-2 text-center">หน่วย</th><th className="px-3 py-2 text-right">จัดการ</th></tr></thead><tbody>{sectionRows.map((row) => { const shifts = getShiftsForSection(row.sourceSectionDefId || activeSection?.id); const meta = getWipMeta(row.skuCode); return <tr key={row.tempId} className="border-b border-slate-200"><td className="px-3 py-2"><input type="date" disabled={isLocked} value={row.workDate || ""} onChange={(event) => handleLineChange(row.tempId, "workDate", event.target.value)} className="h-8 border border-slate-300 px-2" /></td><td className="px-3 py-2"><select disabled={isLocked} value={row.shiftCode || ""} onChange={(event) => { const shift = shifts.find((item) => item.shiftCode === event.target.value); handleLineChange(row.tempId, "shiftCode", event.target.value); if (shift) { handleLineChange(row.tempId, "shiftId", shift.shiftId); handleLineChange(row.tempId, "shiftName", shift.shiftName); } }} className="h-8 border border-slate-300 px-2">{shifts.map((shift) => <option key={shift.shiftId} value={shift.shiftCode}>{shift.shiftName} ({shift.shiftCode})</option>)}</select></td><td className="px-3 py-2"><select disabled={isLocked || Boolean(row.id)} value={row.skuCode || ""} onChange={(event) => handleLineChange(row.tempId, "skuCode", event.target.value)} className="h-8 min-w-[150px] border border-slate-300 px-2"><option value="">เลือกรหัส WIP</option>{wipSkuCatalog.map((sku) => <option key={sku.sku_code} value={sku.sku_code}>{sku.sku_code}</option>)}</select></td><td className="px-3 py-2 font-semibold">{row.skuName || "-"}</td><td className="px-3 py-2"><input type="nu
mber" min="0" disabled={isLocked} value={row.plannedQty || ""} onChange={(event) => handleLineChange(row.tempId, "plannedQty", event.target.value === "" ? 0 : Number(event.target.value))} className="h-8 w-full border border-slate-300 px-2 text-right" /></td><td className="px-3 py-2 text-center">{meta.planningUnit}</td><td className="px-3 py-2 text-right"><button type="button" disabled={isLocked} onClick={() => handleRemoveWipRow(row.tempId)} className="text-red-700 disabled:opacity-30"><Trash2 size={15} /></button></td></tr>; })}</tbody></table></div><button type="button" disabled={isLocked || !activeSection} onClick={() => handleAddWipRow(activeSection?.name)} className="mt-4 flex h-9 items-center gap-2 bg-[#102C57] px-4 text-xs font-bold text-white disabled:opacity-40"><Plus size={14} /> เพิ่ม WIP ใน Section นี้</button></div></div></div>;
