    "description": "Verifies a planner can create a master plan draft, calculate materials, and publish a master snapshot that generates sub-plans.",
    "category": "Master Plan Creation & Publish (Production Planning - Master)",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
